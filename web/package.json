  },
  "dependencies": {
    "echarts": "6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "16.14.68",
    "@types/react-dom": "16.9.25",
    "eslint": "10.14.0",
    "jsdom": "27.4.0",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
